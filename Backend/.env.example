# Backend Server Configuration
PORT=5000

# MongoDB Connection String (Atlas URI in Render, or local URI in dev)
# Example for Atlas: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/fixmate?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/fixmate

# JWT Secret Key for token signing
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL for CORS (Set this in Render to your Vercel deployment URL)
# Example: https://fixmate.vercel.app
CLIENT_URL=http://localhost:5173

# Interactive Demo Mode Configuration
# Master switch to enable or disable public demo access
DEMO_MODE_ENABLED=true

# Dedicated cryptographic secret key strictly for signing and verifying Demo JWTs
DEMO_JWT_SECRET=your_demo_jwt_secret_here



